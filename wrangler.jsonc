{
  "name": "bookstore-demo",
  "main": "app/entry.worker.ts",
  "compatibility_date": "2024-11-11",

  // Dev server configuration (for Docker container)
  "dev": {
    "ip": "0.0.0.0",
    "port": 5173,
    "local_protocol": "http"
  },

  // D1 Database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookstore-db",
      "database_id": "local-db-id-placeholder",
      "migrations_dir": "database/migrations"
    }
  ],

  // KV Namespace bindings
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "local-session-kv-id-placeholder"
    },
    {
      "binding": "CART_KV",
      "id": "local-cart-kv-id-placeholder"
    }
  ],

  // R2 Bucket bindings
  "r2_buckets": [
    {
      "binding": "UPLOADS_BUCKET",
      "bucket_name": "bookstore-uploads"
    }
  ],

  // Assets configuration for static files
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Environment-specific configurations
  "env": {
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bookstore-db-test",
          "database_id": "test-db-id-placeholder",
          "migrations_dir": "database/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "test-session-kv-id-placeholder"
        },
        {
          "binding": "CART_KV",
          "id": "test-cart-kv-id-placeholder"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS_BUCKET",
          "bucket_name": "bookstore-uploads-test"
        }
      ]
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bookstore-db-prod",
          "database_id": "prod-db-id-placeholder",
          "migrations_dir": "database/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "prod-session-kv-id-placeholder"
        },
        {
          "binding": "CART_KV",
          "id": "prod-cart-kv-id-placeholder"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS_BUCKET",
          "bucket_name": "bookstore-uploads-prod"
        }
      ]
    }
  }
}
