{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/dom",
    "lib": ["ES2024", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": { "~/*": ["./*"] },
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["./types/worker-configuration.d.ts", "./types/worker-runtime.d.ts", "./types/global.d.ts"],
    "verbatimModuleSyntax": true,
  },
  "include": ["**/*.ts", "**/*.tsx", "types/**/*.d.ts"],
  "exclude": ["node_modules", ".wrangler", "dist"]
}
